{
  "contract_extension_version": "2026-08-07.2",
  "base_contract_version": "2026-08-03.2",
  "paths": {
    "/api/v1/households/{household_id}/preparation-operations/schedules/{schedule_id}/execution-snapshot": {
      "methods": ["get"],
      "authenticated": true
    },
    "/api/v1/households/{household_id}/preparation-operations/schedules/{schedule_id}/execution-aware-repair-snapshot": {
      "methods": ["get"],
      "authenticated": true
    },
    "/api/v1/households/{household_id}/preparation-operations/repair-proposals/{proposal_id}/task-lineage": {
      "methods": ["get"],
      "authenticated": true
    }
  },
  "schemas": {
    "PreparationExecutionTaskSnapshot": {
      "required": ["task_id", "state", "latest_event_id"]
    },
    "PreparationExecutionSnapshot": {
      "required": [
        "snapshot_version",
        "source_schedule_id",
        "source_schedule_version",
        "latest_execution_event_id",
        "execution_event_count",
        "execution_event_ledger_hash",
        "task_states",
        "frozen_task_ids",
        "repairable_task_ids",
        "in_progress_task_ids",
        "captured_at",
        "execution_snapshot_hash"
      ]
    },
    "PreparationExecutionAwareTaskEvidence": {
      "required": [
        "task_id",
        "state",
        "planned_start_minute",
        "planned_finish_minute",
        "dependencies",
        "frozen",
        "terminal",
        "repairable"
      ]
    },
    "PreparationExecutionAwareRepairSnapshot": {
      "required": [
        "household_id",
        "source_schedule_id",
        "source_schedule_version",
        "source_schedule_status",
        "source_schedule_hash",
        "canonical_execution_snapshot_hash",
        "event_count",
        "event_ids",
        "event_chain_hash",
        "tasks",
        "frozen_task_ids",
        "active_task_ids",
        "terminal_task_ids",
        "satisfied_dependency_task_ids",
        "repairable_task_ids",
        "ready_repairable_task_ids",
        "blocked_repairable_tasks",
        "snapshot_hash",
        "requires_human_acceptance",
        "repair_computation_performed",
        "persistence_performed",
        "limitations"
      ]
    },
    "PreparationRepairTaskLineageStatus": {
      "enum": [
        "preserved",
        "frozen_by_execution",
        "shifted",
        "newly_introduced",
        "removed_before_execution",
        "blocked_by_in_progress_predecessor",
        "superseded_by_replacement"
      ]
    },
    "PreparationRepairTaskLineageEntry": {
      "required": [
        "source_task_id",
        "replacement_task_id",
        "status",
        "source_execution_state",
        "source_latest_event_id",
        "source_start_minute",
        "source_finish_minute",
        "replacement_start_minute",
        "replacement_finish_minute"
      ]
    },
    "PreparationRepairTaskLineage": {
      "required": [
        "source_schedule_id",
        "source_schedule_version",
        "source_execution_snapshot_hash",
        "entries"
      ]
    }
  }
}
