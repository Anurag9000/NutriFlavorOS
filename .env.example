# Required for authentication. Generate an unpredictable value of at least 32 characters.
SECRET_KEY=replace-with-a-random-secret

# Local default; use PostgreSQL in hosted deployments.
DATABASE_URL=sqlite:///nutriflavor.db

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

JWT_ISSUER=nutriflavos-api
JWT_AUDIENCE=nutriflavos-web
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Deterministic horizon optimizer bounds. Larger values improve search breadth
# but increase CPU and memory use.
MEAL_OPTIMIZER_BEAM_WIDTH=48
MEAL_OPTIMIZER_OPTIONS_PER_SLOT=36

# Experimental capabilities remain disabled unless backed by validated data.
ENABLE_SUSTAINABILITY_ESTIMATES=false
ENABLE_EXTERNAL_FLAVOR_DATA=false

# Optional upstream-service credentials.
RECIPEDB_API_KEY=
FLAVORDB_API_KEY=
DIETRXDB_API_KEY=
SUSTAINABLEFOODDB_API_KEY=

# Legacy generated fixtures are never enabled implicitly.
MOCK_MODE=false
CACHE_ENABLED=true
CACHE_MAX_ENTRIES=512
